"""Expose $name as a selectable tool capability."""

from roboz.deployment import Capability

from .tool import get_$name

__all__ = ["CAPABILITY"]


class Quotes(Capability):
    """Give the agent this package's tool."""

    def __init__(self) -> None:
        """State the capability's name and how it is offered."""
        super().__init__(
            name="$name",
            selectable=True,  # False makes this capability fixed.
            default=False,  # True runs the tool before the model; this example stops the run.
        )

    def build(self, agent, pipe):
        """Return the tool."""
        return (get_$name,)


CAPABILITY = Quotes()

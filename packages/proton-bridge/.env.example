# Use the host, port, TLS mode, and IMAP credentials shown by your Bridge.
ROBOZ_PROTON_BRIDGE_IMAP_HOST=127.0.0.1
ROBOZ_PROTON_BRIDGE_IMAP_PORT=1143
ROBOZ_PROTON_BRIDGE_TLS_MODE=starttls
ROBOZ_PROTON_BRIDGE_ACCOUNT_ADDRESS=you@example.com
ROBOZ_PROTON_BRIDGE_USERNAME=replace-with-bridge-username
ROBOZ_PROTON_BRIDGE_PASSWORD=replace-with-bridge-password
# Configure trust as appropriate for your Bridge certificate:
# ROBOZ_PROTON_BRIDGE_CA_FILE=/absolute/path/to/bridge-ca.pem
# ROBOZ_PROTON_BRIDGE_CERTIFICATE_SHA256=replace-with-certificate-fingerprint
